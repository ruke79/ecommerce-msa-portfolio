{
  "type": "record",
  "name": "OrderSagaState",
  "namespace": "com.project.common.avro",
  "doc": "주문 하나의 결제 사가 진행 상태 — saga-projection(Kafka Streams)이 order·payment 토픽을 접어 만든다. 토픽 order-saga-state(키 = orderId 문자열, 컴팩션). 요청·응답 양쪽을 한 곳에서 보는 읽기 모델이지 진실의 원천이 아니다: 진실은 order/pay 의 DB 다.",
  "fields": [
    { "name": "orderId",     "type": "long" },
    { "name": "phase",       "type": { "type": "enum", "name": "SagaPhase", "namespace": "com.project.common.avro",
        "symbols": ["REQUESTED", "COMPLETED", "FAILED", "CANCELED", "ORPHAN_RESPONSE"], "default": "REQUESTED",
        "doc": "REQUESTED: 결제 요청만 봄. COMPLETED/FAILED/CANCELED: 응답의 paymentStatus. ORPHAN_RESPONSE: 요청을 못 본 채 응답이 먼저 왔다 — 토픽 둘은 순서가 독립이라 정상적으로도 잠깐 생기고, 오래 남으면 요청 릴레이가 죽은 것이다" },
        "default": "REQUESTED" },
    { "name": "customerId",  "type": ["null", "long"],   "default": null },
    { "name": "amounts",     "type": ["null", "string"], "default": null, "doc": "BigDecimal.toPlainString() — PaymentRequest.avsc 와 같은 규칙" },
    { "name": "couponName",  "type": ["null", "string"], "default": null },
    { "name": "paymentId",   "type": ["null", "long"],   "default": null },
    { "name": "paymentStatus", "type": ["null", "string"], "default": null, "doc": "응답의 PaymentStatus 이름. enum 을 또 복제하지 않으려고 문자열" },
    { "name": "requestedAt", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null,
      "doc": "PaymentRequest.createdAt(UTC). 없으면 프로젝션이 요청을 본 시각" },
    { "name": "respondedAt", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null,
      "doc": "프로젝션이 응답을 본 시각 — PaymentResponse 에는 시각이 없다" },
    { "name": "requestCount",  "type": "int", "default": 0, "doc": "본 요청 수. 2 이상이면 릴레이 재발행(at-least-once)이 실제로 일어난 것" },
    { "name": "responseCount", "type": "int", "default": 0 },
    { "name": "updatedAt",   "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
