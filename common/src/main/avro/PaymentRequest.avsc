{
  "type": "record",
  "name": "PaymentRequest",
  "namespace": "com.project.common.avro",
  "doc": "v4(paypalOrderId 제거 — 참조는 providerPaymentId 하나, docs/49 §3 C2). v3(제공자 중립 필드 추가)·v2(authorizationToken 제거)·v1 은 avro-history/. order → pay 결제 요청. 토픽 order. DTO com.project.common.message.dto.request.PaymentRequest 와 1:1 — 변환은 PaymentRequestAvroMapping. 필드를 더할 때는 끝에 붙이고 한 릴리스 동안 옛 작성 스키마로 쓴다. 뺄 때는 다음 스키마를 디코더에 먼저 넣고 한 릴리스 뒤에 바꾼다.",
  "fields": [
    {
      "name": "orderId",
      "type": "long",
      "doc": "파티션 키이기도 하다"
    },
    {
      "name": "customerId",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "trackingId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "couponName",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "amounts",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "BigDecimal.toPlainString(). decimal 논리 타입 대신 문자열인 이유: 자릿수를 스키마에 고정하지 않고도 손실이 없다"
    },
    {
      "name": "orderStatus",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "OrderStatus",
          "namespace": "com.project.common.avro",
          "symbols": [
            "NOT_PROCESSED",
            "PAID",
            "UNPAID",
            "PROCESSING",
            "DISPATCHED",
            "DELIVERED",
            "CANCELED",
            "COMPLETED",
            "REFUNDED"
          ],
          "default": "NOT_PROCESSED"
        }
      ],
      "default": null
    },
    {
      "name": "paymentType",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "PaymentType",
          "namespace": "com.project.common.avro",
          "symbols": [
            "PAYPAL",
            "STRIPE",
            "PORTONE",
            "CREDIT_CARD",
            "CASH"
          ],
          "default": "PAYPAL"
        }
      ],
      "default": null
    },
    {
      "name": "paymentStatus",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "PaymentStatus",
          "namespace": "com.project.common.avro",
          "symbols": [
            "COMPLETED",
            "CANCELED",
            "FAILED"
          ],
          "default": "FAILED"
        }
      ],
      "default": null
    },
    {
      "name": "createdAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "UTC epoch millis. DTO 의 LocalDateTime 은 UTC 로 간주한다"
    },
    {
      "name": "paymentProvider",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "PaymentProvider",
          "namespace": "com.project.common.avro",
          "symbols": [
            "PAYPAL",
            "STRIPE",
            "PORTONE",
            "BANK_TRANSFER"
          ]
        }
      ],
      "default": null,
      "doc": "v3. 결제를 확인해 준 곳. v2 레코드에서는 null 이다"
    },
    {
      "name": "providerPaymentId",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "v3. 제공자가 확인해 준 결제 참조(PayPal 이면 PayPal 주문 ID). v2 레코드에서는 null — paypalOrderId 를 본다"
    }
  ]
}
