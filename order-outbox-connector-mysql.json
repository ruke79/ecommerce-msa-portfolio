{
  "name": "order-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "",
    "database.port": "3306",
    "database.user": "",
    "database.password": "${file:/etc/kafka-connect/secrets/connect-secrets.properties:db-password}",
    "database.server.id": "1",
    "database.connectionTimeZone": "Asia/Seoul",
    "database.include.list": "paydb",
    "table.include.list": "paydb.order_outbox_event",
    "database.history.kafka.bootstrap.servers": "<localhost>:<9092>",
    "schema.history.internal.kafka.bootstrap.servers": "<localhost>:<9092>",
    "schema.history.internal.kafka.topic": "history.payment",
    "topic.prefix": "order.outbox",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter",
    "transforms": "outbox,route1",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.by.field": "event_type",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.timestamp": "created_at",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.route1.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route1.regex": "^payment-response$",
    "transforms.route1.replacement": "payment"
  }
}
