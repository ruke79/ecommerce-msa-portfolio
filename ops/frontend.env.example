# 프론트엔드 빌드 값 — ops/19-build-images.sh(ops/33 도 이것을 부른다)가 자동으로 읽는다.
#
#   cp ops/frontend.env.example ops/frontend.env   # ops/frontend.env 는 gitignore — 환경마다 다르다
#
# 여기 값은 번들(브라우저)에 그대로 박히는 **공개 값**만이다. 비밀(PAYPAL_CLIENT_SECRET, PORTONE_API_SECRET,
# STRIPE_SECRET_KEY …)은 절대 여기에 두지 않는다 — k8s/20-secret.yaml(gitignore) 에 둔다(B-51).
# 환경 변수로 넘긴 값이 있으면 그쪽이 이긴다. `KEY=값` 한 줄에 하나, 따옴표는 한 겹 벗긴다. 파일은 실행되지 않는다(source 하지 않음).

# 사이트 주소(경로 없이). 비어 있으면 번들의 API 주소가 undefined 가 된다.
REACT_APP_API_URL=https://shop.example.com

# PayPal client id — 공개 값이다(샌드박스 키도 된다). 비어 있으면 체크아웃의 PayPal SDK 로딩이 깨진다.
REACT_APP_PAYPAL_CLIENT_ID=

# 포트원(선택). V2 는 Store ID(store-…)·채널 키(channel-key-…) — 둘이 있으면 V2 로 동작한다.
REACT_APP_PORTONE_STORE_ID=
REACT_APP_PORTONE_CHANNEL_KEY=
# 이니시스 일본결제(CBT JPPG) 상점 이메일 — 결제창 storeDetails 의 필수 칸(공개 값)
REACT_APP_PORTONE_STORE_EMAIL=
# V1(옛 계정) — 가맹점 식별코드(imp…)와 PG 코드
REACT_APP_PORTONE_IMP_CODE=
REACT_APP_PORTONE_PG=html5_inicis

# 상점 통화 — 서버의 STORE_CURRENCY 와 같아야 한다
REACT_APP_STORE_CURRENCY=USD
