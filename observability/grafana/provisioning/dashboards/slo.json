          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "라우트별 5xx 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
