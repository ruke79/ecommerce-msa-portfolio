{
  "uid": "slo",
  "title": "ecommerce-msa SLO",
  "description": "SLO 다섯의 남은 오류 · 지연 예산, 소진율, 게이트웨이 라우트, 바깥 탐침, 컨슈머 지연 — 규칙은 observability/alert-rules.yml 의 slo · slo-budget · kafka-consumer 그룹(docs/91).",
  "tags": [
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "slo",
        "type": "query",
        "label": "SLO",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:objective:availability, slo)",
          "refId": "slo"
        },
        "definition": "label_values(slo:objective:availability, slo)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/ecommerce-overview",
      "targetBlank": false
    }
