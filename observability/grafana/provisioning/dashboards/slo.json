      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{service=\"gateway-server\",routeId!=\"chat-service-ws\",httpStatusCode=~\"5..\"}[5m])) / sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{service=\"gateway-server\",routeId!=\"chat-service-ws\"}[5m]))",
          "legendFormat": "{{routeId}}"
        }
      ],
      "description": "게이트웨이에서 본 5xx — 회로 차단 폴백(/fallback 503) · 연결 실패 · 다운스트림 시간 초과(504)는 서비스 쪽 지표에 없다."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "라우트별 2초를 넘은 비율",
      "datasource": {
        "type": "prometheus",
