          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_bucket{service=\"gateway-server\",routeId!=\"chat-service-ws\",le=\"2.0\"}[5m])) / sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{service=\"gateway-server\",routeId!=\"chat-service-ws\"}[5m]))",
          "legendFormat": "{{routeId}}"
        }
      ],
      "description": "chat-service-ws(SockJS · WebSocket)는 연결이 끝날 때까지 한 요청이라 뺐다."
